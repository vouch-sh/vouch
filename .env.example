# Vouch Server Environment Variables
# Copy this file to .env and fill in values for local development.
# See docs/src/reference/environment-variables.md for full documentation.

# =============================================================================
# MaxMind GeoIP (used at build time to download GeoLite2 databases)
# =============================================================================
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# =============================================================================
# Rust Logging
# =============================================================================
RUST_LOG=info,vouch_server=debug

# =============================================================================
# Core Configuration
# =============================================================================

# Relying Party ID (domain). Used as the WebAuthn RP ID.
VOUCH_RP_ID=localhost

# Relying Party display name shown in browser prompts and UI.
VOUCH_RP_NAME=Vouch

# Database connection URL. Supports sqlite:, postgres:, and Aurora DSQL.
VOUCH_DATABASE_URL=sqlite:vouch.db?mode=rwc

# JWT signing secret (minimum 32 characters). Required unless VOUCH_JWT_HMAC_KMS_KEY_ID is set.
# Generate: openssl rand -base64 32
VOUCH_JWT_SECRET=

# Base URL for this server. Auto-derived from VOUCH_RP_ID if not set.
# VOUCH_BASE_URL=http://localhost:3000

# Organization name for branding in the UI. Falls back to VOUCH_RP_NAME if not set.
# VOUCH_ORG_NAME=

# Comma-separated list of allowed email domains for enrollment.
# If not set, all domains are allowed.
# VOUCH_ALLOWED_DOMAINS=example.com,corp.example.com

# =============================================================================
# Network
# =============================================================================

# Address and port to listen on. Ignored when TLS is configured.
VOUCH_LISTEN_ADDR=[::]:3000

# =============================================================================
# Upstream Identity Providers
# =============================================================================
# Comma-separated list of IdP slugs. At least one is required.
# Slugs match [a-z0-9-]{1,32}. Hyphens become underscores in variable names.
VOUCH_IDPS=google

# --- OIDC IdP Example (slug: google) ---
VOUCH_IDP_GOOGLE_TYPE=oidc
VOUCH_IDP_GOOGLE_ISSUER=https://accounts.google.com
VOUCH_IDP_GOOGLE_CLIENT_ID=
VOUCH_IDP_GOOGLE_CLIENT_SECRET=

# --- OIDC IdP Example (slug: entra) ---
# VOUCH_IDP_ENTRA_TYPE=oidc
# VOUCH_IDP_ENTRA_ISSUER=https://login.microsoftonline.com/organizations/v2.0
# VOUCH_IDP_ENTRA_CLIENT_ID=
# VOUCH_IDP_ENTRA_CLIENT_SECRET=

# --- SAML IdP Example (slug: corp-saml) ---
# VOUCH_IDP_CORP_SAML_TYPE=saml
# VOUCH_IDP_CORP_SAML_METADATA_URL=https://idp.example.com/metadata
# VOUCH_IDP_CORP_SAML_SP_ENTITY_ID=https://vouch.example.com
# VOUCH_IDP_CORP_SAML_EMAIL_ATTRIBUTE=
# VOUCH_IDP_CORP_SAML_DOMAIN_ATTRIBUTE=

# =============================================================================
# Session
# =============================================================================

# Session duration in hours.
# VOUCH_SESSION_HOURS=8

# Device code expiration in seconds.
# VOUCH_DEVICE_CODE_EXPIRES=600

# Device code polling interval in seconds.
# VOUCH_DEVICE_POLL_INTERVAL=5

# =============================================================================
# SSH CA
# =============================================================================

# SSH CA private key content (base64-encoded PEM, Ed25519).
# Generate file: ssh-keygen -t ed25519 -f ssh_ca_key -N ""
# Then base64-encode: base64 < ssh_ca_key
# VOUCH_SSH_CA_KEY=

# Path to SSH CA private key file (raw PEM). Set to empty string to disable SSH CA.
# VOUCH_SSH_CA_KEY_PATH=./ssh_ca_key

# =============================================================================
# OIDC Signing Keys
# =============================================================================

# ECDSA P-256 signing key (base64-encoded PEM). Used for ES256 access/ID tokens.
# If not set, an ephemeral key is generated on each restart (not recommended for production).
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | base64
# VOUCH_OIDC_SIGNING_KEY=

# RSA-3072 signing key (base64-encoded PEM). Used for RS256 ID tokens.
# Minimum 3072-bit key enforced.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | base64
# VOUCH_OIDC_RSA_SIGNING_KEY=

# =============================================================================
# AWS KMS (alternative to local keys)
# =============================================================================

# KMS key ID for SSH CA signing (Ed25519). Overrides VOUCH_SSH_CA_KEY.
# VOUCH_SSH_CA_KMS_KEY_ID=

# KMS key ID for OIDC token signing (P-256 ECDSA). Overrides VOUCH_OIDC_SIGNING_KEY.
# VOUCH_OIDC_SIGNING_KMS_KEY_ID=

# KMS key ID for OIDC RSA token signing (RSA-3072). Overrides VOUCH_OIDC_RSA_SIGNING_KEY.
# VOUCH_OIDC_RSA_SIGNING_KMS_KEY_ID=

# KMS key ID for HMAC state token signing. Overrides VOUCH_JWT_SECRET.
# VOUCH_JWT_HMAC_KMS_KEY_ID=

# =============================================================================
# DPoP (Demonstrating Proof-of-Possession)
# =============================================================================

# Maximum age of DPoP proofs in seconds.
# VOUCH_DPOP_MAX_AGE=300

# =============================================================================
# FIDO2 / Attestation
# =============================================================================

# Require full attestation certificate chain (e.g., YubiKey packed attestation).
# VOUCH_REQUIRE_ATTESTATION_CERT=false

# =============================================================================
# Cleanup & Retention
# =============================================================================

# Background cleanup task interval in minutes. Set to 0 to disable.
# VOUCH_CLEANUP_INTERVAL=15

# Retention period for authentication events in days.
# VOUCH_AUTH_EVENTS_RETENTION_DAYS=90

# Retention period for OAuth usage events in days.
# VOUCH_OAUTH_EVENTS_RETENTION_DAYS=90

# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of CORS allowed origins. Empty = same-origin only.
# VOUCH_CORS_ORIGINS=

# =============================================================================
# GitHub App Integration
# =============================================================================

# VOUCH_GITHUB_APP_NAME=
# VOUCH_GITHUB_APP_ID=
# GitHub App private key (PEM format, RSA). Download from GitHub App settings.
# Base64-encode: base64 < github-app-key.pem
# VOUCH_GITHUB_APP_KEY=
# Generate: openssl rand -hex 32
# VOUCH_GITHUB_WEBHOOK_SECRET=
# VOUCH_GITHUB_APP_CLIENT_ID=
# VOUCH_GITHUB_APP_CLIENT_SECRET=

# =============================================================================
# TLS (enables HTTPS on port 443 with HTTP→HTTPS redirect on port 80)
# =============================================================================

# TLS certificate (base64-encoded PEM).
# Generate self-signed (dev only): openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -days 365 -nodes -keyout tls.key -out tls.crt -subj "/CN=localhost"
# Then: base64 < tls.crt
# VOUCH_TLS_CERT=

# TLS private key (base64-encoded PEM).
# Then: base64 < tls.key
# VOUCH_TLS_KEY=

# =============================================================================
# S3 Configuration (centralized config management)
# =============================================================================

# S3 bucket name. If set, config is loaded from S3.
# VOUCH_S3_CONFIG_BUCKET=

# S3 object key for configuration file.
# VOUCH_S3_CONFIG_KEY=config/vouch-server.json

# AWS region for S3 access.
# VOUCH_S3_CONFIG_REGION=

# S3 config polling interval in seconds.
# VOUCH_S3_CONFIG_POLL_INTERVAL=60

# =============================================================================
# JWT Assertion (RFC 7523)
# =============================================================================

# Maximum lifetime (seconds) for private_key_jwt client-authentication assertions.
# VOUCH_JWT_ASSERTION_MAX_LIFETIME=300

# =============================================================================
# Protected Resource Metadata (RFC 9728)
# =============================================================================

# VOUCH_RESOURCE_NAME=Vouch
# VOUCH_RESOURCE_DOCUMENTATION=https://vouch.sh/docs/
# VOUCH_RESOURCE_POLICY_URI=https://vouch.sh/privacy/
# VOUCH_RESOURCE_TOS_URI=https://vouch.sh/terms/

# =============================================================================
# CLI Download URLs (displayed in server UI)
# =============================================================================

# VOUCH_CLI_DOWNLOAD_MACOS=
# VOUCH_CLI_DOWNLOAD_LINUX=
# VOUCH_CLI_DOWNLOAD_WINDOWS=

# =============================================================================
# AWS (for KMS, DSQL, or S3 access)
# =============================================================================

# AWS_PROFILE=
# AWS_REGION=us-east-1
