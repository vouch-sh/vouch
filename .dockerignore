# Exclude everything by default
*

# Root build files
!Cargo.toml
!Cargo.lock

# Workspace crate manifests (needed for dependency caching layer)
!crates/vouch-common/Cargo.toml
!crates/vouch-server/Cargo.toml
!crates/vouch-cli/Cargo.toml
!crates/vouch-agent/Cargo.toml
!crates/vouch-tests/Cargo.toml

# Source code: only server and its shared dependency
!crates/vouch-common/src/
!crates/vouch-server/src/
!crates/vouch-server/data/
!crates/vouch-server/migrations/
!crates/vouch-server/templates/
!crates/vouch-server/static/
!crates/vouch-server/styles/
!crates/vouch-server/tailwind.config.js
