// Deny issuance after 5 failed logins in ten minutes.
//
// Counts failed `Login` responses for this user, which includes attempts
// denied by a posture policy. Slows credential-stuffing against a user
// whose hardware key is present but whose device keeps failing checks.
@id("failed_login_burst")
forbid (principal, action == Vouch::Action::"IssueToken", resource)
when temporal {
    exists (n: Long). (
        (count_within(10m, Vouch::Action::"Login"::response{ output.result: false })) == n
        && n >= 5
    )
};
