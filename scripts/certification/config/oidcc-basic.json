{
  "description": "Vouch {VERSION} OIDC Basic OP Certification",
  "server": {
    "discoveryUrl": "{BASEURL}/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "{CLIENT_ID}",
    "client_secret": "{CLIENT_SECRET}",
    "scope": "openid email"
  },
  "browser": [
    {
      "match": "{BASEURL}/login*",
      "tasks": [
        {
          "task": "Click",
          "selector": "#cert-login"
        }
      ]
    }
  ]
}
