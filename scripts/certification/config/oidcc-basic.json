{
  "description": "Vouch {VERSION} OIDC Basic OP Certification",
  "variant": {
    "server_metadata": "discovery",
    "client_registration": "dynamic_client"
  },
  "server": {
    "discoveryUrl": "{BASEURL}/.well-known/openid-configuration"
  },
  "client": {
    "client_name": "vouch-oidcc-basic",
    "scope": "openid email"
  },
  "browser": [
    {
      "match": "{BASEURL}/login*",
      "tasks": [
        {
          "task": "Click",
          "selector": "#cert-login"
        }
      ]
    }
  ]
}
