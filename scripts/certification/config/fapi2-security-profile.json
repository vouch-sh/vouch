{
  "description": "Vouch FAPI 2.0 Security Profile Certification",
  "publish": "everything",
  "server": {
    "discoveryUrl": "{BASEURL}/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "{CLIENT_ID}",
    "scope": "openid"
  },
  "browser": [
    {
      "match": "{BASEURL}/login*",
      "tasks": [
        {
          "task": "Click",
          "selector": "#cert-login"
        }
      ]
    }
  ]
}
