<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Homebrew users: use `brew services start vouch` instead of this plist.
         This file is for manual/MDM installations where vouch-agent is placed
         in /usr/local/bin/. -->

    <key>Label</key>
    <string>sh.vouch.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/vouch-agent</string>
        <string>--foreground</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>Library/Logs/vouch-agent.log</string>

    <key>StandardErrorPath</key>
    <string>Library/Logs/vouch-agent.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
