[Unit]
Description=Vouch identity server
Documentation=https://github.com/vouch-sh/vouch
After=network-online.target vouch-config.service
Wants=network-online.target
Requires=vouch-config.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=vouch
Group=vouch
EnvironmentFile=/run/vouch-server/env
Environment=AWS_CONFIG_FILE=/dev/null
Environment=AWS_SHARED_CREDENTIALS_FILE=/dev/null
Environment=AWS_USE_DUALSTACK_ENDPOINT=true
Environment=AWS_STS_REGIONAL_ENDPOINTS=regional
Environment=AWS_DEFAULTS_MODE=in-region
ExecStart=/usr/bin/vouch-server
Restart=always
RestartSec=30
StandardOutput=append:/var/log/vouch-server/output.log
StandardError=append:/var/log/vouch-server/output.log
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vouch-server
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
