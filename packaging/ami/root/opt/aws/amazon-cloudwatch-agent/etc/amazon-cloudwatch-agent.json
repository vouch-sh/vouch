{
  "agent": {
    "run_as_user": "cwagent",
    "logfile": "",
    "use_dualstack_endpoint": true
  },
  "metrics": {
    "namespace": "VouchServer",
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_available_percent",
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "procstat": [
        {
          "exe": "vouch-server",
          "measurement": [
            "cpu_usage",
            "memory_rss",
            "memory_swap",
            "num_threads",
            "num_fds"
          ],
          "metrics_collection_interval": 60
        }
      ]
    },
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "force_flush_interval": 60
  },
  "logs": {
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "log_group_name": "/vouch-server/vouch-server",
            "log_stream_name": "{instance_id}",
            "priority": "info",
            "retention_in_days": 3
          }
        ]
      }
    },
    "force_flush_interval": 5
  }
}
