[Unit]
Description=Vouch identity server
Documentation=https://github.com/vouch-sh/vouch
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=vouch
Group=vouch
EnvironmentFile=-/etc/vouch-server/env
EnvironmentFile=-/run/vouch-server/env
ExecStart=/usr/bin/vouch-server
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vouch-server
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
